# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PORT=3003
HOST=127.0.0.1

# ─── LLM Providers ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Optional providers
GOOGLE_API_KEY=
TOGETHER_API_KEY=

# ─── Default model per role ──────────────────────────────────────────────────
# Roles: planner | architect | coder | reviewer | tester | debugger | devops | optimizer
MODEL_PLANNER=gpt-4o
MODEL_CODER=gpt-4o
MODEL_REVIEWER=claude-3-5-sonnet-20241022
MODEL_TESTER=gpt-4o-mini
MODEL_DEVOPS=gpt-4o-mini

# ─── Storage ─────────────────────────────────────────────────────────────────
STORAGE_PATH=./data
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://devteam:devteam@127.0.0.1:55432/devteam

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_in_production
API_KEY_SALT=change_me_in_production

# ─── Limits ──────────────────────────────────────────────────────────────────
MAX_CONCURRENT_SESSIONS=5
MAX_TOKENS_PER_REQUEST=128000
MONTHLY_BUDGET_USD=100

# Per-project generation cost guard. Leave unset to disable in local dev.
# Warnings are persisted at 75% and 90%; hard stops only apply when enabled.
GENERATION_BUDGET_SOFT_USD=
GENERATION_BUDGET_WARNING_THRESHOLD=0.75
GENERATION_BUDGET_CRITICAL_THRESHOLD=0.90
GENERATION_BUDGET_HARD_STOP=false

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:3001
NEXT_PUBLIC_WS_BASE=ws://localhost:3001
# Frontend telemetry is opt-in until backend ingestion route is implemented.
NEXT_PUBLIC_TELEMETRY_ENABLED=0

# API auth boundaries
AUTH_TOKEN_SECRET=change_me_in_production
AUTH_ACCESS_TOKEN_TTL_SEC=900
AUTH_REFRESH_TOKEN_TTL_SEC=2592000
AUTH_PASSWORD_RESET_TOKEN_TTL_SEC=3600
AUTH_VERIFY_EMAIL_TOKEN_TTL_SEC=86400
DEV_AUTH_BYPASS=false
DEV_USER_ID=dev-user
DEV_WORKSPACE_ID=dev-workspace
DEV_USER_EMAIL=dev@local.test
DEV_USER_ROLE=owner

# Optional frontend aliases (when set, they control browser-side dev auth headers/badge)
NEXT_PUBLIC_DEV_AUTH_BYPASS=false
NEXT_PUBLIC_DEV_USER_ID=dev-user
NEXT_PUBLIC_DEV_WORKSPACE_ID=dev-workspace
NEXT_PUBLIC_DEV_USER_EMAIL=dev@local.test
NEXT_PUBLIC_DEV_USER_ROLE=owner

# Backward-compatible aliases
DEV_AUTH_BYPASS_USER_ID=dev-user
DEV_AUTH_BYPASS_WORKSPACE_ID=dev-workspace
DEV_AUTH_BYPASS_USER_EMAIL=dev@local.test
DEV_AUTH_BYPASS_ROLE=owner
