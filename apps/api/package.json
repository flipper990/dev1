{
  "name": "@devteam/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --ignore \"data/**\" --ignore \"./data/**\" --ignore \"**/data/**\" src/server.ts",
    "build": "tsc",
    "start": "tsx src/server.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test:auth": "tsx --test src/security/auth.test.ts",
    "test:contracts": "tsx --test src/routes/api-contract.test.ts",
    "test:generations": "tsx src/testing/generation-runner.ts"
  },
  "dependencies": {
    "@devteam/types": "*",
    "@anthropic-ai/sdk": "^0.39.0",
    "openai": "^4.78.0",
    "fastify": "^5.2.0",
    "@fastify/websocket": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.0",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.0",
    "drizzle-orm": "^0.38.0",
    "zod": "^3.24.0",
    "nanoid": "^5.0.9",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "dotenv": "^16.4.7",
    "archiver": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/archiver": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
